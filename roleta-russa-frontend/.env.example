# URL base da API do backend PRINCIPAL (roleta-russa-backend, em Java)
# Local (rodando o backend via Docker/Tomcat na sua máquina):
VITE_API_URL=http://localhost:8080

# Produção (exemplo, ajuste para a URL real do seu deploy):
# VITE_API_URL=https://roleta-russa-api.onrender.com

# URL do servidor de multiplayer (Socket.IO), que roda no backend Node
# (roleta-russa-backend-node). É um serviço separado do VITE_API_URL acima
# de propósito - veja roleta-russa-backend-node/README.md.
VITE_SOCKET_URL=http://localhost:3001

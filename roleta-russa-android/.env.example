# URL base da API PRINCIPAL do backend (roleta-russa-backend, em Java).
#
# IMPORTANTE: no React Native (Expo) quem faz as chamadas é o app rodando
# no celular/emulador, não um navegador na sua máquina - então
# "localhost" NÃO funciona apontando pro seu computador.
#
# - Emulador Android (Android Studio): use 10.0.2.2 (alias especial que
#   aponta pro localhost da máquina host dentro do emulador)
# - Dispositivo físico (Expo Go): use o IP da sua máquina na rede local
#   (ex: 192.168.0.10), com celular e computador na mesma Wi-Fi
# - Produção: URL pública do backend (Render, etc.)
#
# Variáveis do Expo expostas ao app precisam do prefixo EXPO_PUBLIC_.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# URL do servidor de MULTIPLAYER (Socket.IO), que roda no backend Node
# (roleta-russa-backend-node) - é um serviço SEPARADO do backend Java
# acima, de propósito (veja roleta-russa-backend-node/README.md). Sem ele
# rodando, a tela de Multiplayer conecta mas nunca lista/cria salas.
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3001

# Configuração do MySQL para o backend Node.
# Dentro do docker-compose, o host do banco é o nome do serviço "db".
# Rodando fora do Docker (ex: node ./bin/www direto na sua máquina, com
# "docker compose up -d db" pra subir só o banco), use DB_HOST=localhost.
DB_HOST=db
DB_PORT=3306
DB_NAME=roleta_russa
DB_USER=root
DB_PASSWORD=NovaSenhaForte123!

# Porta HTTP + WebSocket (Socket.IO) deste backend.
PORT=3000

# Origens liberadas no CORS (separadas por vírgula). O front-end em dev
# roda em http://localhost:5173.
ALLOWED_ORIGINS=http://localhost:5173
